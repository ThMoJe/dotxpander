<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!-- Identity -->
  <assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="*"
    name="aiVOLUTION.dotXPANDER"
    type="win32"
  />

  <description>dotXPANDER — Lightweight Windows Text Expander</description>

  <!-- ── UAC: run as standard user, never request elevation ─────────────── -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- ── Supported Windows versions ─────────────────────────────────────── -->
  <!-- Declaring these unlocks modern API behaviour and suppresses Compat shims -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
    </application>
  </compatibility>

  <!-- ── DPI awareness: Per-Monitor v2 ──────────────────────────────────── -->
  <!-- Prevents OS bitmap-scaling on HiDPI / multi-monitor setups.           -->
  <!-- PMv2 is the recommended setting for Windows 10 1803+ GUI apps.        -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Primary: Per-Monitor v2 (Windows 10 1703+) -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        PerMonitorV2
      </dpiAwareness>
      <!-- Fallback for pre-1703: system-aware -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
        true
      </dpiAware>
      <!-- Long path support (paths > 260 characters) -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
        true
      </longPathAware>
      <!-- UTF-8 active code page — ensures correct string handling -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">
        UTF-8
      </activeCodePage>
      <!-- Heap type: Segment Heap reduces memory fragmentation -->
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">
        SegmentHeap
      </heapType>
    </windowsSettings>
  </application>

  <!-- ── Common Controls v6 (enables visual styles) ─────────────────────── -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

</assembly>
