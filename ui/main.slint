import { ScrollView } from "std-widgets.slint";

// Data model for the snippet table
export struct SnippetModel {
    trigger: string,
    replacement: string,
    mode: string,  // "immediate" or "hotkey"
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("icon.png");
    in-out property <string> tray-tooltip-text: ".XPANDER\nClick for settings";
    in-out property <string> tray-open-text: "Open settings";
    in-out property <string> tray-quit-text: "Quit";
    
    tooltip: tray-tooltip-text;
    
    // Left-click on tray icon opens settings directly
    clicked => { open-settings(); }
    
    Menu {
        MenuItem {
            title: tray-open-text;
            activated => { open-settings(); }
        }
        MenuItem {
            title: tray-quit-text;
            activated => { quit-app(); }
        }
    }
    
    callback open-settings();
    callback quit-app();
}

export component ConfigWindow inherits Window {
    in-out property <string> window-title-text: ".XPANDER - Settings";
    title: window-title-text;
    icon: @image-url("icon.png");
    min-width: 722px;
    min-height: 485px;
    preferred-width: 843px;
    preferred-height: 523px;
    default-font-size: 14px;
    background: #1e1e2e;
    
    // Active tab: 0 = General, 1 = Snippets, 2 = About
    in-out property <int> active-tab: 0;

    // Properties bound from Rust
    in-out property <string> hotkey-display: "CTRL+SHIFT+T";
    in-out property <bool> hotkey-capturing: false;
    in-out property <bool> hotkey-conflict: false;
    in-out property <bool> hotkey-can-save: false;
    in-out property <[SnippetModel]> snippets;
    in-out property <string> buffer-content: "";
    in-out property <string> config-file-path: "";
    
    // i18n string properties — set exclusively from Rust (src/i18n.rs is the single source of truth).
    // All defaults are "" intentionally: if a property appears non-empty at runtime, a setter is missing.
    in-out property <string> i18n-header: "";
    in-out property <string> i18n-hotkey-label: "";
    in-out property <string> i18n-hotkey-save: "";
    in-out property <string> i18n-hotkey-label-tooltip: "";
    in-out property <string> i18n-hotkey-prompt: "";
    in-out property <string> i18n-buffer-label: "";
    in-out property <string> i18n-buffer-empty: "";
    in-out property <string> i18n-buffer-size-label: "";
    in-out property <string> i18n-buffer-size-tooltip: "";
    in-out property <string> buffer-size-text: "10";
    in-out property <string> i18n-col-trigger: "";
    in-out property <string> i18n-col-replacement: "";
    in-out property <string> i18n-col-mode: "";
    in-out property <string> i18n-mode-immediate: "";
    in-out property <string> i18n-mode-hotkey: "";
    in-out property <string> i18n-btn-delete: "";
    in-out property <string> i18n-btn-add: "";
    in-out property <string> i18n-btn-quit: "";
    in-out property <string> i18n-btn-cancel: "";
    in-out property <string> i18n-btn-save: "";
    in-out property <string> i18n-current-lang: "";
    in-out property <string> i18n-uninstall-btn: "";
    in-out property <string> i18n-uninstall-tooltip: "";
    in-out property <string> i18n-col-trigger-tooltip: "";
    in-out property <string> i18n-btn-pause: "";
    in-out property <string> i18n-btn-resume: "";
    in-out property <string> i18n-btn-pause-tooltip: "";
    in-out property <string> i18n-btn-cancel-tooltip: "";
    in-out property <string> save-error-message: "";
    in-out property <bool> is-paused: false;
    in-out property <bool> quick-switch-enabled: false;
    in-out property <string> i18n-quick-switch-label: "";
    in-out property <string> i18n-quick-switch-tooltip: "";
    in-out property <bool> case-changer-enabled: true;
    in-out property <string> i18n-case-changer-label: "";
    in-out property <string> i18n-case-changer-tooltip: "";
    in-out property <string> case-changer-hotkey-display: "CTRL+CAPSLOCK";
    in-out property <bool> case-changer-hotkey-capturing: false;
    in-out property <bool> case-changer-hotkey-conflict: false;
    in-out property <bool> case-changer-hotkey-can-save: false;
    in-out property <bool> hotkey-is-default: true;
    in-out property <bool> case-changer-hotkey-is-default: true;
    in-out property <string> i18n-hotkey-reset-tooltip: "";
    in-out property <string> i18n-case-changer-reset-tooltip: "";
    in-out property <bool> snippet-hotkey-enabled: true;
    in-out property <string> i18n-tab-general: "";
    in-out property <string> i18n-tab-snippets: "";
    in-out property <string> i18n-section-hotkey: "";
    in-out property <string> i18n-section-features: "";
    // Portable / Installed mode
    in-out property <bool> is-portable: false;
    in-out property <string> i18n-mode-portable: "";
    in-out property <string> i18n-mode-installed: "";
    in-out property <string> i18n-move-config: "";
    in-out property <string> i18n-move-config-tooltip: "";
    in-out property <string> i18n-mode-portable-tooltip: "";
    
    // About tab properties
    in-out property <string> i18n-tab-about: "";
    in-out property <string> about-version-arch: "";
    in-out property <string> i18n-about-tagline: "";
    in-out property <string> i18n-about-developed-by: "";
    in-out property <string> i18n-about-btn-website: "";
    in-out property <string> i18n-about-btn-github: "";
    in-out property <string> i18n-about-license: "";
    in-out property <string> i18n-about-disclaimer-title: "";
    in-out property <string> i18n-about-disclaimer-text: "";
    
    // Callbacks to Rust
    callback save-config();
    callback cancel-config();
    callback buffer-size-step(int);
    callback buffer-size-edited(string);
    callback buffer-size-focus-lost();
    callback add-snippet();
    callback remove-snippet(int);
    callback move-snippet-up(int);
    callback move-snippet-down(int);
    callback hotkey-clicked();
    callback key-recorded(string, bool, bool, bool, bool) -> bool;
    callback save-hotkey();
    callback reset-hotkey-to-default();
    callback quit-app();
    callback language-changed(string);
    callback uninstall-app();
    callback open-config-folder();
    callback move-config-folder();
    callback toggle-pause();
    callback quick-switch-toggled(bool);
    callback snippet-hotkey-toggled(bool);
    callback case-changer-toggled(bool);
    callback case-changer-hotkey-clicked();
    callback case-changer-key-recorded(string, bool, bool, bool, bool) -> bool;
    callback save-case-changer-hotkey();
    callback reset-case-changer-hotkey-to-default();
    callback open-website();
    callback open-github();
    callback open-license();
    
    // Full-window Rectangle ensures the dark background always fills the window,
    // even after hide/show cycles where Window.background may not redraw correctly.
    Rectangle {
        background: #1e1e2e;
        width: 100%;
        height: 100%;
        
        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 16px;
            spacing: 10px;
        
        // ── Global header: title + language toggle (always visible) ──────────
        HorizontalLayout {
            vertical-stretch: 0;
            height: 28px;
            spacing: 12px;
            
            Text {
                text: i18n-header;
                font-size: 20px;
                font-weight: 700;
                color: #cdd6f4;
                vertical-alignment: center;
            }
            
            // Spacer
            Rectangle { horizontal-stretch: 1; }
            
            // Language toggle button (upper right, always visible)
            Rectangle {
                border-width: 0px;
                border-radius: 6px;
                background: #89b4fa;
                width: 110px;
                height: 28px;
                
                Text {
                    text: i18n-current-lang;
                    color: #1e1e2e;
                    font-weight: 600;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (i18n-current-lang == "English") {
                            language-changed("da");
                        } else {
                            language-changed("en");
                        }
                    }
                }
            }
        }
        
        // ── Tab bar (underline style) ────────────────────────────────────────
        HorizontalLayout {
            vertical-stretch: 0;
            height: 40px;
            spacing: 0px;

            // General tab
            Rectangle {
                min-width: 150px;
                background: transparent;

                tab-general-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.active-tab = 0; }
                }

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    Text {
                        text: i18n-tab-general;
                        color: active-tab == 0 ? #cdd6f4 : (tab-general-touch.has-hover ? #a6adc8 : #6c7086);
                        font-weight: active-tab == 0 ? 700 : 400;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        vertical-stretch: 1;
                    }

                    // Active underline
                    Rectangle {
                        height: 3px;
                        background: active-tab == 0 ? #89b4fa : transparent;
                        border-radius: 1.5px;
                    }
                }
            }

            // Snippets tab
            Rectangle {
                min-width: 160px;
                background: transparent;

                tab-snippets-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.active-tab = 1; }
                }

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    Text {
                        text: i18n-tab-snippets;
                        color: active-tab == 1 ? #cdd6f4 : (tab-snippets-touch.has-hover ? #a6adc8 : #6c7086);
                        font-weight: active-tab == 1 ? 700 : 400;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        vertical-stretch: 1;
                    }

                    // Active underline
                    Rectangle {
                        height: 3px;
                        background: active-tab == 1 ? #89b4fa : transparent;
                        border-radius: 1.5px;
                    }
                }
            }

            // About tab
            Rectangle {
                min-width: 130px;
                background: transparent;

                tab-about-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.active-tab = 2; }
                }

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    Text {
                        text: i18n-tab-about;
                        color: active-tab == 2 ? #cdd6f4 : (tab-about-touch.has-hover ? #a6adc8 : #6c7086);
                        font-weight: active-tab == 2 ? 700 : 400;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        vertical-stretch: 1;
                    }

                    // Active underline
                    Rectangle {
                        height: 3px;
                        background: active-tab == 2 ? #89b4fa : transparent;
                        border-radius: 1.5px;
                    }
                }
            }

            // Right spacer + bottom border line under whole tab bar
            Rectangle {
                horizontal-stretch: 1;
                min-width: 200px;
                background: transparent;

                // Bottom border line continuing under the spacer
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: 100%;
                    background: #45475a;
                }
            }
        }

        // ── Tab content area ─────────────────────────────────────────────────
        // The two tabs use conditional rendering via `if` — only the active
        // one is in the visual tree at any time.

        // ── GENERAL TAB ──────────────────────────────────────────────────────
        if active-tab == 0 : VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            padding: 0px;
            min-width: 680px;

            // ── Section: Hotkey ──────────────────────────────────────────────
            HorizontalLayout {
                vertical-stretch: 0;
                height: 20px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: i18n-section-hotkey;
                    color: #6c7086;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: #45475a;
                    horizontal-stretch: 1;
                }
            }

            // ── Snippet hotkey row: [✓] label  [capture box]  [Set] ──────────
            HorizontalLayout {
                vertical-stretch: 0;
                height: 36px;
                spacing: 8px;

                // Enable/disable checkbox
                sh-checkbox := Rectangle {
                    width: 34px;
                    height: 36px;

                    sh-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.snippet-hotkey-enabled = !root.snippet-hotkey-enabled;
                            root.snippet-hotkey-toggled(root.snippet-hotkey-enabled);
                        }
                    }

                    Rectangle {
                        x: 8px;
                        y: 9px;
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: snippet-hotkey-enabled ? #89b4fa : #585b70;
                        background: snippet-hotkey-enabled ? #89b4fa : transparent;

                        if snippet-hotkey-enabled : Text {
                            text: "\u{2713}";
                            color: #1e1e2e;
                            font-weight: 700;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Label — clicking it also toggles the checkbox
                Rectangle {
                    vertical-stretch: 0;

                    sh-label-text := Text {
                        text: i18n-hotkey-label;
                        color: snippet-hotkey-enabled ? #bac2de : #45475a;
                        vertical-alignment: center;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.snippet-hotkey-enabled = !root.snippet-hotkey-enabled;
                                root.snippet-hotkey-toggled(root.snippet-hotkey-enabled);
                            }
                        }
                    }

                    if sh-touch.has-hover : Rectangle {
                        x: 0px;
                        y: -32px;
                        width: sh-tip-text.preferred-width + 16px;
                        height: 26px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            sh-tip-text := Text {
                                text: i18n-hotkey-label-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { horizontal-stretch: 1; }

                // Hotkey capture box
                hotkey-box := FocusScope {
                    width: 220px;
                    height: 36px;
                    enabled: snippet-hotkey-enabled;

                    Rectangle {
                        border-width: 1px;
                        border-color: hotkey-conflict ? #f38ba8
                                    : (hotkey-capturing ? #89b4fa
                                    : (snippet-hotkey-enabled ? #585b70 : #313244));
                        border-radius: 6px;
                        background: hotkey-conflict ? #5a1e2e : (hotkey-capturing ? #1e3a5f : #313244);
                        opacity: snippet-hotkey-enabled ? 1.0 : 0.45;

                        Text {
                            text: hotkey-display;
                            color: hotkey-conflict ? #f38ba8 : (hotkey-capturing ? #f9e2af : #a6e3a1);
                            font-weight: 600;
                            font-size: hotkey-conflict ? 12px : 14px;
                            font-italic: hotkey-capturing;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    TouchArea {
                        enabled: snippet-hotkey-enabled;
                        mouse-cursor: snippet-hotkey-enabled ? pointer : default;
                        clicked => {
                            hotkey-box.focus();
                            root.hotkey-capturing = true;
                            root.hotkey-conflict = false;
                            root.hotkey-can-save = false;
                            root.hotkey-display = root.i18n-hotkey-prompt;
                            root.hotkey-clicked();
                        }
                    }

                    key-pressed(event) => {
                        if (root.hotkey-capturing) {
                            if (root.key-recorded(
                                event.text,
                                event.modifiers.control,
                                event.modifiers.alt,
                                event.modifiers.shift,
                                event.modifiers.meta
                            )) {
                                return accept;
                            }
                        }
                        return reject;
                    }
                }

                // Set button
                Rectangle {
                    border-width: 1px;
                    border-color: hotkey-can-save ? #89b4fa : #45475a;
                    border-radius: 6px;
                    background: hotkey-can-save ? #89b4fa : #313244;
                    width: 70px;
                    height: 36px;
                    opacity: hotkey-can-save ? 1.0 : 0.45;

                    Text {
                        text: i18n-hotkey-save;
                        color: hotkey-can-save ? #1e1e2e : #6c7086;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    TouchArea {
                        enabled: hotkey-can-save;
                        mouse-cursor: hotkey-can-save ? pointer : default;
                        clicked => { root.save-hotkey(); }
                    }
                }

                // Reset to default button (↺)
                Rectangle {
                    border-width: 1px;
                    border-color: (!hotkey-is-default && snippet-hotkey-enabled) ? (reset-touch.has-hover ? #b4befe : #89b4fa) : #45475a;
                    border-radius: 6px;
                    background: (!hotkey-is-default && snippet-hotkey-enabled) ? (reset-touch.has-hover ? #45475a : #313244) : #313244;
                    width: 36px;
                    height: 36px;
                    opacity: (!hotkey-is-default && snippet-hotkey-enabled) ? 1.0 : 0.35;

                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke: (!hotkey-is-default && snippet-hotkey-enabled) ? #89b4fa : #6c7086;
                        stroke-width: 2.2px;
                        commands: "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 L 3 8 L 8 8";
                    }

                    reset-touch := TouchArea {
                        enabled: !hotkey-is-default && snippet-hotkey-enabled;
                        mouse-cursor: (!hotkey-is-default && snippet-hotkey-enabled) ? pointer : default;
                        clicked => { root.reset-hotkey-to-default(); }
                    }

                    if reset-touch.has-hover : Rectangle {
                        x: parent.width - self.width;
                        y: -34px;
                        width: reset-tip-text.preferred-width + 16px;
                        height: 26px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            reset-tip-text := Text {
                                text: i18n-hotkey-reset-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Case Changer row: [✓] label  [capture box]  [Set] ───────────
            HorizontalLayout {
                vertical-stretch: 0;
                height: 36px;
                spacing: 8px;

                // Enable/disable checkbox
                cc-checkbox := Rectangle {
                    width: 34px;
                    height: 36px;

                    cc-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.case-changer-enabled = !root.case-changer-enabled;
                            root.case-changer-toggled(root.case-changer-enabled);
                        }
                    }

                    Rectangle {
                        x: 8px;
                        y: 9px;
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: case-changer-enabled ? #89b4fa : #585b70;
                        background: case-changer-enabled ? #89b4fa : transparent;

                        if case-changer-enabled : Text {
                            text: "\u{2713}";
                            color: #1e1e2e;
                            font-weight: 700;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Label — clicking it also toggles the checkbox
                Rectangle {
                    vertical-stretch: 0;

                    cc-label-text := Text {
                        text: i18n-case-changer-label;
                        color: case-changer-enabled ? #bac2de : #45475a;
                        vertical-alignment: center;

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.case-changer-enabled = !root.case-changer-enabled;
                                root.case-changer-toggled(root.case-changer-enabled);
                            }
                        }
                    }

                    if cc-touch.has-hover : Rectangle {
                        x: 0px;
                        y: -32px;
                        width: cc-tip-text.preferred-width + 16px;
                        height: 26px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cc-tip-text := Text {
                                text: i18n-case-changer-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Spacer
                Rectangle { horizontal-stretch: 1; }

                // Hotkey capture box
                cc-hotkey-box := FocusScope {
                    width: 220px;
                    height: 36px;
                    enabled: case-changer-enabled;

                    Rectangle {
                        border-width: 1px;
                        border-color: case-changer-hotkey-conflict ? #f38ba8
                                    : (case-changer-hotkey-capturing ? #89b4fa
                                    : (case-changer-enabled ? #585b70 : #313244));
                        border-radius: 6px;
                        background: case-changer-hotkey-conflict ? #5a1e2e
                                  : (case-changer-hotkey-capturing ? #1e3a5f : #313244);
                        opacity: case-changer-enabled ? 1.0 : 0.45;

                        Text {
                            text: case-changer-hotkey-display;
                            color: case-changer-hotkey-conflict ? #f38ba8
                                 : (case-changer-hotkey-capturing ? #f9e2af : #a6e3a1);
                            font-weight: 600;
                            font-size: case-changer-hotkey-conflict ? 12px : 14px;
                            font-italic: case-changer-hotkey-capturing;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    TouchArea {
                        enabled: case-changer-enabled;
                        mouse-cursor: case-changer-enabled ? pointer : default;
                        clicked => {
                            cc-hotkey-box.focus();
                            root.case-changer-hotkey-capturing = true;
                            root.case-changer-hotkey-conflict = false;
                            root.case-changer-hotkey-can-save = false;
                            root.case-changer-hotkey-display = root.i18n-hotkey-prompt;
                            root.case-changer-hotkey-clicked();
                        }
                    }

                    key-pressed(event) => {
                        if (root.case-changer-hotkey-capturing) {
                            if (root.case-changer-key-recorded(
                                event.text,
                                event.modifiers.control,
                                event.modifiers.alt,
                                event.modifiers.shift,
                                event.modifiers.meta
                            )) {
                                return accept;
                            }
                        }
                        return reject;
                    }
                }

                // Set button
                Rectangle {
                    border-width: 1px;
                    border-color: case-changer-hotkey-can-save ? #89b4fa : #45475a;
                    border-radius: 6px;
                    background: case-changer-hotkey-can-save ? #89b4fa : #313244;
                    width: 70px;
                    height: 36px;
                    opacity: case-changer-hotkey-can-save ? 1.0 : 0.45;

                    Text {
                        text: i18n-hotkey-save;
                        color: case-changer-hotkey-can-save ? #1e1e2e : #6c7086;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    TouchArea {
                        enabled: case-changer-hotkey-can-save;
                        mouse-cursor: case-changer-hotkey-can-save ? pointer : default;
                        clicked => { root.save-case-changer-hotkey(); }
                    }
                }

                // Reset to default button (↺)
                Rectangle {
                    border-width: 1px;
                    border-color: (!case-changer-hotkey-is-default && case-changer-enabled) ? (cc-reset-touch.has-hover ? #b4befe : #89b4fa) : #45475a;
                    border-radius: 6px;
                    background: (!case-changer-hotkey-is-default && case-changer-enabled) ? (cc-reset-touch.has-hover ? #45475a : #313244) : #313244;
                    width: 36px;
                    height: 36px;
                    opacity: (!case-changer-hotkey-is-default && case-changer-enabled) ? 1.0 : 0.35;

                    Path {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 16px;
                        height: 16px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        stroke: (!case-changer-hotkey-is-default && case-changer-enabled) ? #89b4fa : #6c7086;
                        stroke-width: 2.2px;
                        commands: "M 3 12 A 9 9 0 1 0 12 3 A 9.75 9.75 0 0 0 5.26 5.74 L 3 8 M 3 3 L 3 8 L 8 8";
                    }

                    cc-reset-touch := TouchArea {
                        enabled: !case-changer-hotkey-is-default && case-changer-enabled;
                        mouse-cursor: (!case-changer-hotkey-is-default && case-changer-enabled) ? pointer : default;
                        clicked => { root.reset-case-changer-hotkey-to-default(); }
                    }

                    if cc-reset-touch.has-hover : Rectangle {
                        x: parent.width - self.width;
                        y: -34px;
                        width: cc-reset-tip-text.preferred-width + 16px;
                        height: 26px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cc-reset-tip-text := Text {
                                text: i18n-case-changer-reset-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Section: Features ────────────────────────────────────────────
            HorizontalLayout {
                vertical-stretch: 0;
                height: 20px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: i18n-section-features;
                    color: #6c7086;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 1px;
                    background: #45475a;
                    horizontal-stretch: 1;
                }
            }

            // Quick Switch toggle row
            HorizontalLayout {
                vertical-stretch: 0;
                height: 34px;
                spacing: 4px;

                qs-checkbox := Rectangle {
                    width: 34px;
                    height: 34px;

                    qs-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.quick-switch-enabled = !root.quick-switch-enabled;
                            root.quick-switch-toggled(root.quick-switch-enabled);
                        }
                    }

                    Rectangle {
                        x: 8px;
                        y: 8px;
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: quick-switch-enabled ? #89b4fa : #585b70;
                        background: quick-switch-enabled ? #89b4fa : transparent;

                        if quick-switch-enabled : Text {
                            text: "\u{2713}";
                            color: #1e1e2e;
                            font-weight: 700;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                Text {
                    text: i18n-quick-switch-label;
                    color: quick-switch-enabled ? #cdd6f4 : #6c7086;
                    font-size: 13px;
                    vertical-alignment: center;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.quick-switch-enabled = !root.quick-switch-enabled;
                            root.quick-switch-toggled(root.quick-switch-enabled);
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;

                    if qs-touch.has-hover : Rectangle {
                        y: -4px;
                        width: qs-tip-text.preferred-width + 16px;
                        height: 26px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            qs-tip-text := Text {
                                text: i18n-quick-switch-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Config path row: folder icon | path text | [Move Config...] button | mode badge pill
            HorizontalLayout {
                vertical-stretch: 0;
                height: 26px;
                spacing: 6px;

                // Folder button (matches checkbox width 34px)
                Rectangle {
                    width: 34px;
                    height: 26px;

                    Rectangle {
                        x: 4px;
                        y: 1px;
                        width: 26px;
                        height: 24px;
                        border-radius: 4px;
                        background: folder-touch.has-hover ? #45475a : #313244;
                        border-width: 1px;
                        border-color: folder-touch.has-hover ? #585b70 : #45475a;

                        folder-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { open-config-folder(); }
                        }

                        Text {
                            text: "\u{1F4C1}";
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                Text {
                    text: config-file-path;
                    font-size: 11px;
                    color: #585b70;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                // "Move Config File…" button — only visible in installed mode (to the left of mode badge pill)
                if !is-portable : Rectangle {
                    width: move-btn-text.preferred-width + 20px;
                    height: 24px;
                    border-radius: 4px;
                    border-width: 1px;
                    background: move-btn-touch.has-hover ? #2a3a5a : #1e2a4a;
                    border-color: move-btn-touch.has-hover ? #89b4fa : #585b70;

                    move-btn-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { move-config-folder(); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        move-btn-text := Text {
                            text: i18n-move-config;
                            color: move-btn-touch.has-hover ? #cdd6f4 : #89b4fa;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    if move-btn-touch.has-hover : Rectangle {
                        x: -(380px - (move-btn-text.preferred-width + 20px));
                        y: -54px;
                        width: 380px;
                        height: 48px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            move-tip-text := Text {
                                text: i18n-move-config-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Mode badge pill: "📦 Portable" or "💿 Installed"
                Rectangle {
                    width: mode-badge-text.preferred-width + 14px;
                    height: 20px;
                    border-radius: 10px;
                    background: #313244;
                    border-width: 1px;
                    border-color: #585b70;

                    mode-badge-text := Text {
                        text: is-portable ? i18n-mode-portable : i18n-mode-installed;
                        color: #cdd6f4;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    badge-touch := TouchArea {}

                    if is-portable && badge-touch.has-hover : Rectangle {
                        x: -(320px - (mode-badge-text.preferred-width + 14px));
                        y: -54px;
                        width: 320px;
                        height: 46px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            portable-tip-text := Text {
                                text: i18n-mode-portable-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Spacer pushes Buffer and remaining space to the bottom of the middle section
            Rectangle { vertical-stretch: 1; }

            // Memory & Buffer Size row (bottom of middle section)
            HorizontalLayout {
                vertical-stretch: 0;
                height: 36px;
                spacing: 10px;

                Text {
                    text: i18n-buffer-label;
                    color: #bac2de;
                    vertical-alignment: center;
                }

                Rectangle {
                    border-width: 1px;
                    border-color: #45475a;
                    border-radius: 6px;
                    background: #181825;
                    horizontal-stretch: 1;
                    height: 36px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: buffer-content == "" ? i18n-buffer-empty : buffer-content;
                            color: buffer-content == "" ? #585b70 : #f9e2af;
                            font-family: "Consolas";
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            overflow: elide;
                        }
                    }
                }

                Text {
                    text: i18n-buffer-size-label;
                    color: #bac2de;
                    vertical-alignment: center;
                }

                stepper-container := Rectangle {
                    height: 36px;
                    width: 96px;

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;

                        // Decrement button [-]
                        Rectangle {
                            width: 26px;
                            height: 30px;
                            y: 3px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: dec-touch.has-hover ? #89b4fa : #45475a;
                            background: dec-touch.has-hover ? #313244 : #1e1e2e;

                            Text {
                                text: "-";
                                font-size: 15px;
                                font-weight: 700;
                                color: dec-touch.has-hover ? #89b4fa : #cdd6f4;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            dec-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.buffer-size-step(-1); }
                            }
                        }

                        // 2-character numeric input box
                        Rectangle {
                            width: 36px;
                            height: 30px;
                            y: 3px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: buf-input.has-focus ? #89b4fa : #45475a;
                            background: #181825;

                            buf-input := TextInput {
                                text: buffer-size-text;
                                color: #cdd6f4;
                                font-weight: 600;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                input-type: number;
                                width: parent.width;
                                height: parent.height;
                                edited => { root.buffer-size-edited(self.text); }
                                accepted => { root.buffer-size-focus-lost(); }
                            }
                        }

                        // Increment button [+]
                        Rectangle {
                            width: 26px;
                            height: 30px;
                            y: 3px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: inc-touch.has-hover ? #89b4fa : #45475a;
                            background: inc-touch.has-hover ? #313244 : #1e1e2e;

                            Text {
                                text: "+";
                                font-size: 15px;
                                font-weight: 700;
                                color: inc-touch.has-hover ? #89b4fa : #cdd6f4;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            inc-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.buffer-size-step(1); }
                            }
                        }
                    }

                    // Hover tooltip popup: "Min. = 2, Max = 25"
                    if (dec-touch.has-hover || inc-touch.has-hover) && !buf-input.has-focus : Rectangle {
                        x: -(buf-tip-text.preferred-width + 16px - 96px);
                        y: -34px;
                        width: buf-tip-text.preferred-width + 16px;
                        height: 26px;
                        background: #e6e9ef;
                        border-width: 1px;
                        border-color: #bcc0cc;
                        border-radius: 4px;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #00000088;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            buf-tip-text := Text {
                                text: i18n-buffer-size-tooltip;
                                font-size: 11px;
                                color: #11111b;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Save error message (shown on General tab when hotkey save fails)
            if save-error-message != "" : Text {
                text: save-error-message;
                color: #f38ba8;
                font-size: 12px;
                vertical-stretch: 0;
            }
        } // if active-tab == 0

        // ── SNIPPETS TAB ──────────────────────────────────────────────────────
        if active-tab == 1 : VerticalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            padding: 0px;
            min-width: 680px;

            // Snippet table header
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 6px;
                height: 28px;

                Rectangle { width: 32px; }
                Rectangle {
                    width: 130px;
                    Text { text: i18n-col-trigger; font-weight: 700; color: #89b4fa; vertical-alignment: center; font-size: 12px; }
                }
                Rectangle {
                    min-width: 200px;
                    preferred-width: 320px;
                    horizontal-stretch: 1;
                    Text { text: i18n-col-replacement; font-weight: 700; color: #89b4fa; vertical-alignment: center; }
                }
                Rectangle {
                    width: 110px;
                    Text { text: i18n-col-mode; font-weight: 700; color: #89b4fa; vertical-alignment: center; }
                }
                Rectangle { width: 64px; }
            }

            // Snippet list — Flickable for scroll + manual scrollbar track/thumb
            HorizontalLayout {
                min-height: 120px;
                preferred-height: 240px;
                vertical-stretch: 1;
                spacing: 4px;

                snippet-list := Flickable {
                    horizontal-stretch: 1;
                    interactive: true;
                    // viewport-height auto-sized by Slint from child VerticalLayout —
                    // do NOT set preferred-height or an explicit viewport-height here.
                    // The HorizontalLayout container above limits what Slint asks the
                    // window for, while the Flickable scrolls all rows without clipping.

                    VerticalLayout {
                        spacing: 6px;

                        for snippet[index] in snippets: HorizontalLayout {

                        spacing: 6px;
                        // Height is driven by the tallest child (the replacement textarea).
                        // min-height ensures collapsed rows never shrink below one text line.

                        // Up/Down reorder arrows container (stacked)
                        Rectangle {
                            width: 32px;
                            min-height: 38px;
                            vertical-stretch: 0;

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;

                                // Up arrow button
                                Rectangle {
                                    height: 17px;
                                    width: 32px;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: (index > 0 && up-touch.has-hover) ? #89b4fa : (index > 0 ? #45475a : #313244);
                                    background: (index > 0 && up-touch.has-hover) ? #313244 : (index > 0 ? #1e1e2e : transparent);

                                    Text {
                                        text: "\u{25B2}";
                                        font-size: 9px;
                                        color: index > 0 ? (up-touch.has-hover ? #89b4fa : #cdd6f4) : #45475a;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }

                                    up-touch := TouchArea {
                                        enabled: index > 0;
                                        mouse-cursor: index > 0 ? pointer : default;
                                        clicked => {
                                            root.move-snippet-up(index);
                                        }
                                    }
                                }

                                // Down arrow button
                                Rectangle {
                                    height: 17px;
                                    width: 32px;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: (index < snippets.length - 1 && down-touch.has-hover) ? #89b4fa : (index < snippets.length - 1 ? #45475a : #313244);
                                    background: (index < snippets.length - 1 && down-touch.has-hover) ? #313244 : (index < snippets.length - 1 ? #1e1e2e : transparent);

                                    Text {
                                        text: "\u{25BC}";
                                        font-size: 9px;
                                        color: index < snippets.length - 1 ? (down-touch.has-hover ? #89b4fa : #cdd6f4) : #45475a;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }

                                    down-touch := TouchArea {
                                        enabled: index < snippets.length - 1;
                                        mouse-cursor: index < snippets.length - 1 ? pointer : default;
                                        clicked => {
                                            root.move-snippet-down(index);
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Trigger field (max 10 characters)
                        Rectangle {
                            border-width: 1px;
                            border-color: #585b70;
                            border-radius: 4px;
                            background: #313244;
                            width: 130px;
                            min-height: 38px;
                            vertical-stretch: 0;
                            
                            trigger-input := TextInput {
                                text: snippet.trigger;
                                color: #cdd6f4;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                x: 8px;
                                width: parent.width - 16px;
                                edited => {
                                    // Enforce max 10 character limit on trigger sequences
                                    if self.text.character-count > 10 {
                                        self.text = snippet.trigger;
                                    } else {
                                        snippets[index].trigger = self.text;
                                    }
                                }
                            }
                        }
                        
                        // Replacement field - multi-line textarea with always-visible scrollbar
                        // Enter inserts a newline; Ctrl+Enter moves focus away.
                        Rectangle {
                            border-width: 1px;
                            border-color: repl-input.has-focus ? #89b4fa : #585b70;
                            border-radius: 4px;
                            background: #313244;
                            min-width: 200px;
                            preferred-width: 320px;
                            horizontal-stretch: 1;
                            // Collapsed (2-line default) when unfocused; expands to content (max 100px) when focused
                            height: (trigger-input.has-focus || repl-input.has-focus)
                                ? min(max(repl-input.preferred-height + 12px, 38px), 100px)
                                : 38px;
                            animate height { duration: 150ms; easing: ease-in-out; }

                            repl-scroll := Flickable {
                                x: 6px;
                                y: 4px;
                                width: parent.width - 24px;
                                height: parent.height - 8px;
                                interactive: true;
                                viewport-height: max(repl-input.preferred-height, self.height);

                                repl-input := TextInput {
                                    text: snippet.replacement;
                                    color: #cdd6f4;
                                    single-line: false;
                                    wrap: char-wrap;
                                    width: repl-scroll.width;
                                    height: max(self.preferred-height, repl-scroll.height);
                                    vertical-alignment: top;
                                    horizontal-alignment: left;

                                    edited => {
                                        snippets[index].replacement = self.text;
                                    }
                                    key-pressed(event) => {
                                        if (event.text == "\n" && event.modifiers.control) {
                                            self.clear-focus();
                                            accept
                                        } else {
                                            reject
                                        }
                                    }
                                    cursor-position-changed(cursor-pos) => {
                                        // Keep the cursor line visible when navigating with arrow keys or mouse clicks.
                                        // cursor-pos.y is the cursor pixel position relative to TextInput top.
                                        // Line height approximated at 22px (14px font * ~1.2 line spacing + rounding).
                                        if (cursor-pos.y < -repl-scroll.viewport-y) {
                                            // Cursor above visible area — scroll up
                                            repl-scroll.viewport-y = -cursor-pos.y;
                                        } else if (cursor-pos.y + 22px > -repl-scroll.viewport-y + repl-scroll.height) {
                                            // Cursor below visible area — scroll down
                                            repl-scroll.viewport-y = -(cursor-pos.y + 22px - repl-scroll.height);
                                        }
                                    }
                                }
                            }

                            // Always-visible scrollbar track (right side, inside border)
                            Rectangle {
                                x: parent.width - 14px;
                                y: 4px;
                                width: 8px;
                                height: parent.height - 8px;
                                background: #2a2a3e;
                                border-radius: 4px;

                                Rectangle {
                                    width: 8px;
                                    border-radius: 4px;
                                    background: repl-input.has-focus ? #89b4fa : #585b70;

                                    height: max(
                                        14px,
                                        parent.height * repl-scroll.height / max(1px, repl-scroll.viewport-height)
                                    );

                                    y: (parent.height - self.height)
                                        * (-repl-scroll.viewport-y)
                                        / max(1px, repl-scroll.viewport-height - repl-scroll.height);

                                    animate y { duration: 60ms; easing: ease-out; }
                                }
                            }
                        }
                        
                        // Mode toggle button
                        Rectangle {
                            border-width: 1px;
                            border-color: snippet.mode == "immediate" ? #74c7ec : #fab387;
                            border-radius: 4px;
                            width: 110px;
                            min-height: 38px;
                            vertical-stretch: 0;
                            background: snippet.mode == "immediate" ? #1e3a5f : #3d2e1f;
                            
                            Text {
                                text: snippet.mode == "immediate" ? i18n-mode-immediate : i18n-mode-hotkey;
                                color: snippet.mode == "immediate" ? #74c7ec : #fab387;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            
                            TouchArea {
                                clicked => {
                                    if snippet.mode == "immediate" {
                                        snippets[index].mode = "hotkey";
                                    } else {
                                        snippets[index].mode = "immediate";
                                    }
                                }
                            }
                        }
                        
                        // Delete button
                        Rectangle {
                            border-width: 1px;
                            border-color: #f38ba8;
                            border-radius: 4px;
                            width: 64px;
                            min-height: 38px;
                            vertical-stretch: 0;
                            background: #3d1f2e;
                            
                            Text {
                                text: i18n-btn-delete;
                                color: #f38ba8;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            
                            TouchArea {
                                clicked => { remove-snippet(index); }
                            }
                        }
                        }
                    }
                } // snippet-list Flickable

                // Scrollbar track — only visible when content overflows
                Rectangle {
                    width: 8px;
                    background: #2a2a3e;
                    border-radius: 4px;
                    visible: snippet-list.viewport-height > snippet-list.height;

                    // Thumb — height and position mirror the Flickable scroll state
                    Rectangle {
                        width: 8px;
                        border-radius: 4px;
                        background: #585b70;

                        // Thumb height = track_h × (visible_h / content_h)
                        height: max(
                            24px,
                            parent.height * snippet-list.height / snippet-list.viewport-height
                        );

                        // Thumb y = (track_h - thumb_h) × (scroll_offset / scrollable_range)
                        y: (parent.height - self.height)
                            * (-snippet-list.viewport-y)
                            / max(1px, snippet-list.viewport-height - snippet-list.height);

                        animate y { duration: 60ms; easing: ease-out; }
                    }
                }
            } // outer HorizontalLayout (list + scrollbar)

            // Add button row
            HorizontalLayout {
                vertical-stretch: 0;
                height: 34px;
                spacing: 0px;

                Rectangle {
                    border-width: 1px;
                    border-color: #a6e3a1;
                    border-radius: 6px;
                    background: #1f3d2e;
                    min-width: 130px;
                    height: 34px;

                    Text {
                        text: i18n-btn-add;
                        color: #a6e3a1;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    TouchArea {
                        clicked => { add-snippet(); }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Save error message on Snippets tab
                if save-error-message != "" : Text {
                    text: save-error-message;
                    color: #f38ba8;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Spacer pushes remaining space to the bottom (keeps button bar pinned)
            Rectangle { vertical-stretch: 1; }
        } // if active-tab == 1

        // ── ABOUT TAB ────────────────────────────────────────────────────────
        if active-tab == 2 : VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            padding: 0px;
            min-width: 680px;

            // Card 1: Branding Header (Icon + Name + Version Badge + Tagline)
            Rectangle {
                border-width: 1px;
                border-color: #313244;
                border-radius: 8px;
                background: #181825;
                vertical-stretch: 0;

                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;
                    alignment: start;

                    // App Icon
                    Image {
                        source: @image-url("icon.png");
                        width: 52px;
                        height: 52px;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;

                        // Title + Version/Arch Pill
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            // "." is bold; "XPANDER" is regular-weight — split to mix weights
                            HorizontalLayout {
                                spacing: 0px;
                                vertical-stretch: 0;

                                Text {
                                    text: ".";
                                    font-size: 20px;
                                    font-weight: 900;
                                    color: #cdd6f4;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "XPANDER";
                                    font-size: 20px;
                                    font-weight: 800;
                                    color: #cdd6f4;
                                    vertical-alignment: center;
                                }
                            }

                            // Version & Arch Badge
                            Rectangle {
                                border-radius: 10px;
                                background: #313244;
                                border-width: 1px;
                                border-color: #45475a;
                                height: 22px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;

                                    Text {
                                        text: about-version-arch;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #89b4fa;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Localized Tagline
                        Text {
                            text: i18n-about-tagline;
                            font-size: 13px;
                            color: #a6adc8;
                            vertical-alignment: center;
                        }

                        // Developer credits
                        Text {
                            text: i18n-about-developed-by;
                            font-size: 12px;
                            color: #6c7086;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Card 2: Actions & Links Row
            Rectangle {
                border-width: 1px;
                border-color: #313244;
                border-radius: 8px;
                background: #181825;
                vertical-stretch: 0;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    alignment: start;

                    // User Guide & FAQ button
                    Rectangle {
                        border-width: 1px;
                        border-color: web-touch.has-hover ? #89b4fa : #45475a;
                        border-radius: 6px;
                        background: web-touch.has-hover ? #313244 : #1e1e2e;
                        height: 32px;
                        min-width: 165px;

                        web-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { open-website(); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "📖 " + i18n-about-btn-website;
                                color: web-touch.has-hover ? #cdd6f4 : #bac2de;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // GitHub button
                    Rectangle {
                        border-width: 1px;
                        border-color: gh-touch.has-hover ? #89b4fa : #45475a;
                        border-radius: 6px;
                        background: gh-touch.has-hover ? #313244 : #1e1e2e;
                        height: 32px;
                        min-width: 110px;

                        gh-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { open-github(); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "🐙 " + i18n-about-btn-github;
                                color: gh-touch.has-hover ? #cdd6f4 : #bac2de;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // MIT License Button
                    Rectangle {
                        border-width: 1px;
                        border-color: lic-touch.has-hover ? #89b4fa : #45475a;
                        border-radius: 6px;
                        background: lic-touch.has-hover ? #313244 : #1e1e2e;
                        height: 32px;

                        lic-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { open-license(); }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: "⚖ " + i18n-about-license;
                                color: lic-touch.has-hover ? #cdd6f4 : #bac2de;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // Card 3: Terms & Conditions / Liability Disclaimer
            Rectangle {
                border-width: 1px;
                border-color: #313244;
                border-radius: 8px;
                background: #181825;
                min-height: 80px;
                preferred-height: 140px;
                vertical-stretch: 0;

                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "🛡 " + i18n-about-disclaimer-title;
                            font-size: 12px;
                            font-weight: 700;
                            color: #cdd6f4;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: i18n-about-disclaimer-text;
                        font-size: 11px;
                        color: #9399b2;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }

            // Spacer pushes remaining space to the bottom (keeps button bar pinned)
            Rectangle { vertical-stretch: 1; }
        } // if active-tab == 2

        // ── Global bottom button bar (always visible) ─────────────────────────
        Rectangle { height: 1px; background: #45475a; vertical-stretch: 0; }
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 10px;
            
            // Quit button (left-aligned)
            Rectangle {
                border-width: 0px;
                border-radius: 6px;
                background: #89b4fa;
                min-width: 90px;
                height: 38px;
                
                Text {
                    text: i18n-btn-quit;
                    color: #1e1e2e;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                
                TouchArea {
                    clicked => { quit-app(); }
                }
            }

            // Skull icon — self-destruct / uninstall button
            Rectangle {
                border-width: 1px;
                border-radius: 6px;
                width: 38px;
                height: 38px;

                Text {
                    text: i18n-uninstall-btn;
                    font-size: 18px;
                    color: ta-uninstall.has-hover ? #f38ba8 : #cdd6f4;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                ta-uninstall := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { uninstall-app(); }
                }

                // Reactive hover glow — single binding, no duplicate
                border-color: ta-uninstall.has-hover ? #f38ba8 : #6c7086;
                background: ta-uninstall.has-hover ? #3d1f2e : #2a2a3e;

                // Tooltip popup above button on hover
                if ta-uninstall.has-hover : Rectangle {
                    x: 0px;
                    y: -34px;
                    width: tooltip-text.preferred-width + 16px;
                    height: 26px;
                    background: #e6e9ef;
                    border-width: 1px;
                    border-color: #bcc0cc;
                    border-radius: 4px;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: #00000088;
                    
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        tooltip-text := Text {
                            text: i18n-uninstall-tooltip;
                            font-size: 11px;
                            color: #11111b;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Pause / Resume toggle button
            Rectangle {
                border-width: 1px;
                border-radius: 6px;
                background: is-paused ? #3d2e1f : #313244;
                border-color: is-paused ? #fab387 : #585b70;
                min-width: 110px;
                height: 38px;

                Text {
                    text: is-paused ? i18n-btn-resume : i18n-btn-pause;
                    color: is-paused ? #fab387 : #bac2de;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                pause-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { toggle-pause(); }
                }

                // Tooltip
                if pause-touch.has-hover : Rectangle {
                    x: 0px;
                    y: -34px;
                    width: pause-tip-text.preferred-width + 16px;
                    height: 26px;
                    background: #e6e9ef;
                    border-width: 1px;
                    border-color: #bcc0cc;
                    border-radius: 4px;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: #00000088;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        pause-tip-text := Text {
                            text: i18n-btn-pause-tooltip;
                            font-size: 11px;
                            color: #11111b;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            
            // Spacer pushes remaining buttons to the right
            Rectangle { horizontal-stretch: 1; }
            
            Rectangle {
                border-width: 1px;
                border-color: #585b70;
                border-radius: 6px;
                background: #313244;
                min-width: 110px;
                height: 38px;
                
                Text {
                    text: i18n-btn-cancel;
                    color: #bac2de;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                
                TouchArea {
                    clicked => { cancel-config(); }
                }
            }
            
            Rectangle {
                border-width: 0px;
                border-radius: 6px;
                background: #89b4fa;
                min-width: 110px;
                height: 38px;
                
                Text {
                    text: i18n-btn-save;
                    color: #1e1e2e;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                
                TouchArea {
                    clicked => { save-config(); }
                }
            }
        } // HorizontalLayout (button bar)
        } // VerticalLayout
    } // Rectangle wrapper
}
